{
  "name": "@mcp-switch/companion-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "esbuild": "^0.27.7"
  },
  "engines": {
    "node": ">=24"
  }
}
