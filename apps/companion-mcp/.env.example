COMPANION_HOST=127.0.0.1
COMPANION_PORT=4588
# HTTPS origin reachable by ChatGPT/Claude iframe, even when Switch reaches MCP over localhost.
COMPANION_PUBLIC_URL=http://127.0.0.1:4588
# Exact additional hosts used by Switch on a private Docker network.
COMPANION_ALLOWED_HOSTS=companion
COMPANION_TOKEN=replace-with-a-long-random-secret
COMPANION_DATA_DIR=./data/companion
COMPANION_CHARACTERS=./examples/characters.json
# Set these locally on your server; never commit a real token.
NOVELAI_API_TOKEN=
COMPANION_GENERATION_ENABLED=false
COMPANION_DAILY_LIMIT=10
