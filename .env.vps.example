# Run the new version beside an existing MCP Switch deployment.
# Replace the hostname before starting the container.
MCP_PUBLIC_URL=https://mcp-next.example.com
MCP_GATEWAY_HOST_PORT=4578
MCP_GATEWAY_BIND_HOST=127.0.0.1
MCP_OAUTH_ALLOW_LEGACY_RESOURCE_OMISSION=true

# Optional resource limits.
MCP_CONTAINER_MEMORY_LIMIT=1g
MCP_CONTAINER_CPU_LIMIT=2.0
MCP_CONTAINER_PIDS_LIMIT=256

# Optional named Cloudflare Tunnel overlay. Store only the token in this file,
# without quotes; never commit it.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.secrets/cloudflare-tunnel-token.txt
